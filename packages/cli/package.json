{
  "name": "@multi-profile-provider/cli",
  "version": "0.1.8",
  "description": "internal lifecycle helpers for multi-profile-provider OpenCode setup and cleanup",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jaabg6/multi-profile-provider-opencode.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "bin": {
    "mpp": "dist/index.js",
    "opencode-mpp": "dist/opencode-mpp.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./setup-stack": {
      "types": "./dist/setup-stack/index.d.ts",
      "import": "./dist/setup-stack/index.js"
    },
    "./opencode-mpp": {
      "types": "./dist/opencode-mpp.d.ts",
      "import": "./dist/opencode-mpp.js"
    },
    "./uninstall-stack/args": {
      "types": "./dist/uninstall-stack/args.d.ts",
      "import": "./dist/uninstall-stack/args.js"
    },
    "./uninstall-stack/service": {
      "types": "./dist/uninstall-stack/service.d.ts",
      "import": "./dist/uninstall-stack/service.js"
    },
    "./uninstall-stack/types": {
      "types": "./dist/uninstall-stack/types.d.ts",
      "import": "./dist/uninstall-stack/types.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@multi-profile-provider/core": "0.1.4"
  }
}
