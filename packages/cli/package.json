{
  "name": "@multi-profile-provider/cli",
  "version": "0.1.3",
  "description": "CLI and launcher for multi-profile-provider runtime isolation",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jaabg6/multi-profile-provider-opencode.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "bin": {
    "mpp": "dist/index.js",
    "opencode-mpp": "dist/opencode-mpp.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@multi-profile-provider/core": "0.1.0"
  }
}
