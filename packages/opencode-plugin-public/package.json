{
  "name": "multi-profile-provider-opencode-plugin",
  "version": "0.1.4",
  "description": "OpenCode plugin compatibility package for multi-profile-provider",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jaabg6/multi-profile-provider-opencode.git",
    "directory": "packages/opencode-plugin-public"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./tui": {
      "import": "./dist/tui.js",
      "types": "./dist/tui.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"process.exit(0)\"",
    "typecheck": "node -e \"process.exit(0)\""
  },
  "dependencies": {
    "@multi-profile-provider/core": "0.1.2",
    "@opencode-ai/plugin": "^1.14.30",
    "@opentui/solid": "^0.2.1",
    "solid-js": "^1.9.12"
  }
}
