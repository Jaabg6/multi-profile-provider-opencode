{
  "name": "@multi-profile-provider/core",
  "version": "0.1.4",
  "description": "Core profile registry and runtime isolation services for multi-profile-provider",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jaabg6/multi-profile-provider-opencode.git",
    "directory": "packages/core"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./paths": {
      "types": "./dist/paths.d.ts",
      "import": "./dist/paths.js"
    },
    "./registry-store": {
      "types": "./dist/registry-store.d.ts",
      "import": "./dist/registry-store.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./opencode-auth-swap": {
      "types": "./dist/opencode-auth-swap.d.ts",
      "import": "./dist/opencode-auth-swap.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false"
  }
}
